{
  "name": "@carverauto/serviceradar-dashboard-sdk",
  "version": "0.4.1",
  "description": "ServiceRadar dashboard package SDK for browser module and WASM renderers.",
  "type": "module",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/carverauto/serviceradar-sdk-dashboard.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.js"
    },
    "./frames": {
      "types": "./src/frames.d.ts",
      "default": "./src/frames.js"
    },
    "./react": {
      "types": "./src/react.d.ts",
      "default": "./src/react.js"
    },
    "./blueprint": {
      "types": "./src/blueprint.d.ts",
      "default": "./src/blueprint.js"
    },
    "./srql": {
      "types": "./src/srql.d.ts",
      "default": "./src/srql.js"
    },
    "./query-state": {
      "types": "./src/query-state.d.ts",
      "default": "./src/query-state.js"
    },
    "./filtering": {
      "types": "./src/filtering.d.ts",
      "default": "./src/filtering.js"
    },
    "./arrow": {
      "types": "./src/arrow.d.ts",
      "default": "./src/arrow.js"
    },
    "./map": {
      "types": "./src/map.d.ts",
      "default": "./src/map.js"
    },
    "./popup": {
      "types": "./src/popup.d.ts",
      "default": "./src/popup.js"
    },
    "./camera": {
      "types": "./src/camera.d.ts",
      "default": "./src/camera.js"
    },
    "./live": {
      "types": "./src/live.d.ts",
      "default": "./src/live.js"
    },
    "./config": {
      "types": "./src/config.d.ts",
      "default": "./src/config.js"
    }
  },
  "files": [
    "src",
    "srdashboard"
  ],
  "scripts": {
    "ci": "npm test && npm run pack:check",
    "pack:check": "npm pack --dry-run",
    "test": "npm run test:js && go test ./...",
    "test:js": "node --test tests/*.test.mjs"
  },
  "peerDependencies": {
    "react": ">=19.2.5",
    "react-dom": ">=19.2.5",
    "@blueprintjs/core": "^6.16.0",
    "@blueprintjs/icons": "^6.16.0",
    "@blueprintjs/select": "^6.3.0"
  },
  "peerDependenciesMeta": {
    "@blueprintjs/core": {
      "optional": true
    },
    "@blueprintjs/icons": {
      "optional": true
    },
    "@blueprintjs/select": {
      "optional": true
    }
  },
  "dependencies": {
    "@carverauto/serviceradar-cli": "^0.1.4"
  },
  "devDependencies": {
    "@blueprintjs/core": "^6.23.0",
    "@blueprintjs/icons": "^6.16.0",
    "@blueprintjs/select": "^6.4.2",
    "happy-dom": "^21.0.4",
    "react": "^19.2.5",
    "react-dom": "^19.2.5"
  }
}
